("=== Factorial ===");
function factorial(n) => if (n <= 1) 1 else n * factorial(n - 1);

("factorial(5) = " @ factorial(5));
("factorial(10) = " @ factorial(10));

("");
("=== Fibonacci ===");
function fibonacci(n) => if (n <= 1) n else fibonacci(n - 1) + fibonacci(n - 2);

("fibonacci(10) = " @ fibonacci(10));
("fibonacci(15) = " @ fibonacci(15));

("");
("=== Greatest Common Divisor ===");
function gcd(a, b) => if (b == 0) a else gcd(b, a - floor(a / b) * b);

("gcd(48, 18) = " @ gcd(48, 18));
("gcd(100, 35) = " @ gcd(100, 35));

("");
("=== Power Function ===");
function pow(base, exp) => 
  if (exp == 0) 
    1 
  else 
    base * pow(base, exp - 1);

("pow(2, 10) = " @ pow(2, 10));
("pow(3, 5) = " @ pow(3, 5));

("");
("=== Sum of Natural Numbers ===");
function sum(n) => if (n <= 0) 0 else n + sum(n - 1);

("sum(100) = " @ sum(100));
