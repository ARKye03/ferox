print("=== Arithmetic Operations ===");
print("2 + 3 = " @ (2 + 3));
print("10 - 4 = " @ (10 - 4));
print("5 * 6 = " @ (5 * 6));
print("20 / 4 = " @ (20 / 4));
print("2 ^ 8 = " @ (2 ^ 8));

print("");
print("=== Operator Precedence ===");
print("2 + 3 * 4 = " @ (2 + 3 * 4));
print("(2 + 3) * 4 = " @ ((2 + 3) * 4));
print("2 ^ 3 ^ 2 = " @ (2 ^ 3 ^ 2));
